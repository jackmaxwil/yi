set shell := ["bash", "-euo", "pipefail", "-c"]

bin := "target/debug/yi-desktop"
# Incident: the forge image's `python3` is 3.10, which has no tomllib; the repo's ladder finds a newer one.
py := `../scripts/py.sh`

fmt:
    cargo fmt

fmt-check:
    cargo fmt --check

lint:
    cargo clippy --workspace --all-targets -- -D warnings

har:
    {{py}} tools/gate/har.py

# Every colour in a view is a theme's: the check proves it fires, then scans the views.
colours:
    {{py}} tools/gate/colours.py --selfcheck && {{py}} tools/gate/colours.py

test *FLAGS:
    cargo test --workspace {{FLAGS}}

# Every registered scene, rendered headless; any failed render fails the recipe.
scenes:
    {{py}} tools/harness/scenes.py

# Render only the scenes whose name starts with PREFIX.
scenes-only PREFIX:
    {{py}} tools/harness/scenes.py --only {{PREFIX}}

# The starts journey, then the daily journeys (tests/journeys/daily): each starts a private
# yi serve under target/. They are not part of the task gate.
journey *NAMES:
    {{py}} tools/harness/journey.py {{NAMES}}

# Both always run, so one report shows every finding; either failing fails the recipe.
supply:
    status=0; cargo deny check || status=1; cargo audit || status=1; exit $status

# The gates that build no test: format, lint and the two source scans.
static: fmt-check lint har colours

# What a machine with no Mac can judge: every gate but the pictures. The forge runs it on Linux,
# its tests on the `gate` profile.
gate: static (test "--profile gate")

check: static test tools scenes

# Lay out target/package/Yi Desktop.app (unsigned, the build without tooling) and prove a tooling
# build kept beside it starts headless from inside the bundle.
package:
    {{py}} tools/package/package.py

# Package, then put the app in ~/Applications (`--to DIR` for elsewhere), keeping the one it
# replaces under target/package/previous. Refuses while the installed app is running.
install *ARGS: package
    python3 tools/package/install.py {{ARGS}}

# The packaging and measuring tools' own checks, on scratch folders.
tools:
    python3 tools/package/install.py --selfcheck
    {{py}} tools/harness/feel.py --selfcheck

# Speed budgets, release profile: three rounds, the worst judged against tests/budgets/budgets.json.
budgets:
    {{py}} tests/budgets/run.py

# How a long, real-shaped conversation feels, in process: the median, 95th percentile and
# worst frame of each interaction, in milliseconds. `just budgets` judges three of them.
feel:
    cargo test --release -p yi-desktop --features tooling --test feel -- --test-threads=1 --nocapture | grep '^feel '

# The same conversation in a real window with every frame logged: frames a second and late
# frames a phase. It takes the keyboard for about twelve seconds; a covered window draws nothing.
feel-live *ARGS:
    {{py}} tools/harness/feel.py {{ARGS}}

# Measure the packaged app and write docs/receipts.md (run `just package` and `just budgets` first).
receipts:
    {{py}} tools/package/receipts.py
