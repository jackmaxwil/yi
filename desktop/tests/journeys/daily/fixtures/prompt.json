{
  "about": "⌘N opens New chat; the words typed there make a thread, which the window then shows with its answer streaming into the chat pane.",
  "seed": [
    "hello"
  ],
  "runs": [
    {
      "steps": [
        {
          "t": 3.0,
          "type": "key",
          "name": "n",
          "cmd": true
        },
        {
          "t": 4.0,
          "type": "tap",
          "key": "new-chat.composer.input"
        },
        {
          "t": 4.2,
          "type": "type",
          "text": "what now"
        },
        {
          "t": 5.0,
          "type": "key",
          "name": "Enter"
        },
        {
          "t": 10.0,
          "type": "mark",
          "name": "end"
        }
      ],
      "expect": {
        "texts": [
          "what now",
          "faux:"
        ],
        "contains": [
          "2 threads"
        ]
      }
    }
  ]
}
