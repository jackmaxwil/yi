     "y": 91
    },
    {
     "t": 17,
     "type": "move",
     "x": 1090,
     "y": 91
    },
    {
     "t": 19,
     "type": "mark",
     "name": "end"
    }
   ],
   "expect": {
    "keys": [
     "code-7.L2.fix",
     "code-7.fix-bar.apply",
     "lsp-9.pane-frame",
