#! solo --size 100x34 --faux scripts/proof/tui_see/tool-cell.jsonl
# A read cell and a bash cell, then the closing reply, on a frozen clock so durations hold still.
wait-frame 5000 faux-1
tick 1
type read the greeter and count its defs
key enter
wait-frame 30000 def main(argv)
wait-frame 30000 Composing
tick 8000
wait-idle 30000
snap done
quit
