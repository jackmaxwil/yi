#! solo --size 100x34 --confirm --faux scripts/proof/tui_see/permission.jsonl
# An edit held at the permission gate, then refused, on a frozen clock.
wait-frame 5000 faux-1
tick 1
type tighten greet.py
key enter
wait-frame 30000 requires permission
snap ask
key n
wait-frame 30000 Permission denied
wait-frame 30000 Composing
tick 8000
wait-idle 30000
snap refused
quit
