#! solo --size 100x34 --faux scripts/proof/tui_see/edit-card.jsonl
# An edit card with its diff, after a scratch copy is made and read, on a frozen clock.
wait-frame 5000 faux-1
tick 1
type tighten greet in a scratch copy
key enter
wait-frame 30000 +2
wait-frame 30000 Composing
tick 8000
wait-idle 30000
snap done
quit
