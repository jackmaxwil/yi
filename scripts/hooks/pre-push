#!/usr/bin/env bash
# Main's protection, plus the release gate when the push carries a version tag. The
# lanes run on the forge (`pr.yml`), the gate branch protection reads; running them
# here too was a duplicate verdict at six to eight minutes a push (#307). git feeds
# the refs being pushed on stdin as "<local ref> <local sha> <remote ref> <remote sha>".
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# git exports its own repository context to a hook, and every child inherits it.
# A test that shells out to git then operates on this repo instead of its own
# fixture -- which is how the worktree tests failed only under `git push`.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH GIT_EDITOR

zero='0000000000000000000000000000000000000000'
tag=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: refusing to delete main"
        exit 1
      fi
      # A rewrite of published history is the shape that eats other people's
      # work. An ancestor check catches it without asking git whether --force
      # was typed, which it does not tell a hook.
      if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "pre-push: refusing a non-fast-forward push to main"
        echo "  remote $remote_sha is not an ancestor of $local_sha"
        echo "  reconcile first: git fetch && git rebase origin/main"
        exit 1
      fi
      ;;
  esac
  case "$local_ref" in
    refs/tags/v*) tag="${local_ref#refs/tags/}" ;;
  esac
done

if [ -n "$tag" ]; then
  echo "pre-push: $tag is a release tag"
  just prerelease "${tag#v}"
fi
