+/// Dies with a pin after one switch: two switch misses pin the reading host for an hour.
+#[test]
+fn an_upstream_pin_needs_two_switch_misses_inside_half_an_hour() -> Result<(), Box<dyn Error>> {
+    let minute = 60_000;
+    let mut tracker = MissTracker::default();
+    let mut after = Vec::new();
+    for entry in [
+        request(CLAUDE, (100, 40_000, 0), 0, "Amazon Bedrock")?,
+        request(CLAUDE, (40_100, 0, 0), minute, "Google Vertex")?,
+        request(CLAUDE, (100, 40_000, 0), 2 * minute, "Google Vertex")?,
+        request(CLAUDE, (40_100, 0, 0), 3 * minute, "Amazon Bedrock")?,
+    ] {
+        tracker.observe_entry(&entry);
+        let advice = tracker.advice().ok_or("no advice after a request")?;
+        after.push(advice.pin(4 * minute).map(str::to_owned));
+    }
+    assert_eq!(
+        after,
+        [None, None, None, Some("Google Vertex".to_owned())],
+        "one switch explains its own miss; the second pins the host that read the entry"
+    );
+    let advice = tracker.advice().ok_or("no advice after a request")?;
+    assert_eq!(
+        advice.pin(64 * minute),
+        None,
+        "a pin holds an hour, no longer"
+    );
+    Ok(())
+}
+
+/// Dies with the tail written: four zero-read writes rest the mark, which returns after an hour.
+#[test]
+fn four_zero_read_writes_stop_the_tail_mark_for_an_hour() -> Result<(), Box<dyn Error>> {
+    let second = 1000;
+    let mut tracker = MissTracker::default();
+    let mut tails = Vec::new();
+    for n in 0..5u64 {
+        let at = n * second;
+        tracker.observe_entry(&request(CLAUDE, (0, 0, 40_000), at, "Amazon Bedrock")?);
+        tails.push(
+            tracker
+                .advice()
+                .ok_or("no advice after a request")?
+                .tail(at + second),
+        );
+    }
+    assert_eq!(
+        tails,
+        [true, true, true, true, false],
+        "the fourth unexplained zero-read write suspends the mark, not the third"
+    );
+    let advice = tracker.advice().ok_or("no advice after a request")?;
+    assert!(advice.tail(4 * second + 3_600_000), "the mark is re-probed");
+    Ok(())
+}
diff --git a/docs/changes/2026-10-29-cache-marks-from-the-ledger.md b/docs/changes/2026-10-29-cache-marks-from-the-ledger.md
new file mode 100644
index 000000000..1285451ae
--- /dev/null
+++ b/docs/changes/2026-10-29-cache-marks-from-the-ledger.md
@@ -0,0 +1,16 @@
+---
+issue: Closes #748
+raise: crate ai +146, crate runtime +96, crate types +14, tests +303, comments +17
+growth: +256 (measured against the fork; 336 added, 38 deleted across 18 src files): the two drills in `cache_miss` (+120), the strip-retry and its record in `request` (+70), the tail flag through `LlmContext`/`CachePolicy`/`Breakpoints` (+45), the pinned upstream in `OpenAiOptions` and the provider (+35), the fold rename to `CacheAdvice` (+20), and one `cache_tail: true` line on each of the 15 existing `LlmContext` literals (+15); weighed for deletion: `TtlEstimate` and its `estimate()` accessor are gone, replaced by `CacheAdvice`/`advice()` rather than kept beside it, and no second struct was added for the pin and the tail
+decision: a route's cache marks are escalated from the session ledger, never a flag: two upstream-switch misses inside 30 minutes prefer the host that last read the entry for an hour, four unexplained requests that wrote and read nothing back stop the moving tail mark for an hour, and a 400 naming a cache field is retried once with every cache field stripped | TTL choice by expected cost (D315) settled the entry's life but not the marks around it: OpenRouter moves a conversation across hosts under a live entry, and a tail mark a route never reads back buys no read at all; both are visible in the fold the ledger already gives, so no model, probe or stored state is needed | drop the `escalate` call in `cache_miss::MissTrack`::
+---
+
+A route's cache marks now follow what its own session shows (Closes #748). Three behaviours build on the ledger fold D315 landed, and none of them asks a model.
+
+The upstream: OpenRouter may answer a conversation on a different host between two requests, and an entry the old host wrote is then unreadable there. The fold already names that miss (`upstream switch`) and never counted it. Two of them inside thirty minutes now pin the host that last read the entry: `ProviderStream` sends it as `provider.order` on the next request, by its OpenRouter slug, with fallbacks still allowed, so a name no host matches costs the preference and nothing else. The pin lapses after an hour and the switch count restarts, so a route that keeps moving re-pins and one that settles keeps its entry.
+
+The tail mark: a request's own tail is where the next request reads from, and a route that wrote it and read nothing back for four consecutive unexplained requests is writing a mark nothing reads. The fold stops the moving tail for an hour and keeps every mark before it, the previous tail included, since those are what the next request does read. After the hour the mark is written once more: four more zero-read writes suspend it again, a read ends the run and the mark stays.
+
+The refusal: a provider that does not know a cache field answers 400 rather than ignoring it. A 400 whose body names one of `cache_control`, `cache_ttl`, `prompt_cache_key`, `prompt_cache_retention`, `session_id` or `cache` is now asked again once with every cache field removed from the body, and the reply records the field the route refused as a `cache_stripped` diagnostic, so the ledger says the request went out without its marks. A 400 that names none of them is reported unchanged, never resent: the same body would be refused the same way.
+
+The previous tail needed no switch of its own: D295's build already sends it on every loop request, so the escalation it was meant to gate is unconditional.
