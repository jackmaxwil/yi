#!/usr/bin/env python3
"""Yi channel adapter: github://<owner>/<repo>?every=60s emits each finished workflow run.

Polls `gh api repos/<owner>/<repo>/actions/runs`; the protocol is adapters/README.md.
A failing `gh` exits 1, so the host restarts it and, past its intensity, says so.
"""
import json
import os
import subprocess
import sys
import threading
import time

UNITS = {"s": 1, "m": 60, "h": 3600}


def seconds(text):
    return int(text[:-1]) * UNITS[text[-1]] if text and text[-1] in UNITS else 60


def hang_up_with_the_host():
    for _ack in sys.stdin:
        pass
    os._exit(0)


def main():
    repo, _, every = sys.argv[1].removeprefix("github://").partition("?every=")
    threading.Thread(target=hang_up_with_the_host, daemon=True).start()
    seen = set()
    while True:
        done = subprocess.run(
            ["gh", "api", f"repos/{repo}/actions/runs?per_page=20"],
            capture_output=True, text=True,
        )
        if done.returncode != 0:
            sys.stderr.write(done.stderr)
            sys.exit(1)
        for run in reversed(json.loads(done.stdout).get("workflow_runs", [])):
            key = f"{run['id']}-{run.get('run_attempt', 1)}"
            if run.get("status") != "completed" or key in seen:
                continue
            seen.add(key)
            data = {
                "conclusion": run.get("conclusion"),
                "workflow": run.get("name"),
                "branch": run.get("head_branch"),
                "sha": run.get("head_sha"),
                "url": run.get("html_url"),
            }
            print(json.dumps({"id": key, "at": int(time.time() * 1000), "data": data}), flush=True)
        time.sleep(seconds(every))


if __name__ == "__main__":
    main()
